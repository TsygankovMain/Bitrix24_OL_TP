{
  "name": "comm-hub-bitrix24",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "deploy:prepare": "npm run prisma:generate && npm run build",
    "start": "node dist/main.js",
    "spike:r1": "tsx spike/r1-webhook/index.ts",
    "spike:r4": "tsx spike/r4-imap-smtp/index.ts",
    "spike:r5": "tsx spike/r5-bot-platform/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^5.22.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "fastify": "^5.8.5",
    "imapflow": "^1.0.184",
    "jsonwebtoken": "^9.0.2",
    "libsodium": "^0.8.4",
    "libsodium-wrappers": "^0.7.15",
    "lucide-react": "^0.475.0",
    "mailparser": "^3.7.2",
    "nodemailer": "^8.0.7",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,prisma}": [
      "prettier --write"
    ]
  }
}
